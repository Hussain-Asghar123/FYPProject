<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" android:background="#DDDDDD"/>

    <!-- ═══ STEP: GALLERY ═══ -->
    <LinearLayout android:id="@+id/stepGallery"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tvBallMediaCount"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Ball Media"
                android:textSize="18sp" android:textStyle="bold" android:textColor="#111827"/>
            <TextView android:text="0 items" android:textColor="#6B7280" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Empty state -->
        <LinearLayout android:id="@+id/layoutBallMediaEmpty"
            android:layout_width="match_parent" android:layout_height="120dp"
            android:orientation="vertical" android:gravity="center" android:visibility="gone">
            <TextView android:text="📷" android:textSize="32sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="No media for this ball yet"
                android:textColor="#9CA3AF" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progressBallMedia"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone"
            android:indeterminateTint="#E31212"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBallMedia"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxHeight="300dp" android:visibility="gone"/>

        <Button android:id="@+id/btnGoToUpload"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="16dp" android:text="+ Upload New Media"
            android:backgroundTint="#E31212" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- ═══ STEP: SOURCE ═══ -->
    <LinearLayout android:id="@+id/stepSource"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:visibility="gone">

        <TextView android:text="Select Media Source" android:textSize="17sp"
            android:textStyle="bold" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" android:textColor="#111827"/>

        <!-- Photo Camera -->
        <LinearLayout android:id="@+id/btnBallCamera"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:orientation="horizontal" android:gravity="center"
            android:background="#F9FAFB" android:layout_marginBottom="10dp">
            <TextView android:text="📷  Take Photo" android:textSize="15sp"
                android:textColor="#374151" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ✅ NEW: Video Camera -->
        <LinearLayout android:id="@+id/btnBallVideoCamera"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:orientation="horizontal" android:gravity="center"
            android:background="#F9FAFB" android:layout_marginBottom="10dp">
            <TextView android:text="🎥  Record Video" android:textSize="15sp"
                android:textColor="#374151" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ✅ UPDATED: Gallery (image + video) -->
        <LinearLayout android:id="@+id/btnBallGallery"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:orientation="horizontal" android:gravity="center"
            android:background="#F9FAFB">
            <TextView android:text="🖼️  From Gallery (Photo/Video)" android:textSize="15sp"
                android:textColor="#374151" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:id="@+id/btnBackToGallery"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="← Back to Gallery" android:textColor="#9CA3AF" android:textSize="13sp"/>
    </LinearLayout>

    <!-- ═══ STEP: COMMENT ═══ -->
    <LinearLayout android:id="@+id/stepComment"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:visibility="gone">

        <TextView android:text="Add Comment" android:textSize="17sp"
            android:textStyle="bold" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#111827"/>

        <TextView android:id="@+id/tvBallFileName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center"
            android:textColor="#9CA3AF" android:textSize="12sp" android:singleLine="true"
            android:ellipsize="middle"/>

        <EditText android:id="@+id/etBallComment"
            android:layout_width="match_parent" android:layout_height="80dp"
            android:layout_marginTop="14dp" android:background="#F3F4F6"
            android:padding="10dp" android:hint="Optional comment about this moment…"
            android:textSize="13sp" android:gravity="top|start" android:inputType="textMultiLine"/>

        <Button android:id="@+id/btnBallUpload"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:text="Upload"
            android:backgroundTint="#E31212" android:textColor="#FFFFFF"/>

        <TextView android:id="@+id/btnBackToSource"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center"
            android:text="← Back" android:textColor="#9CA3AF" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>