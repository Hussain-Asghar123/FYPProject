<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏸 Badminton / Table Tennis Stats"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/primaryColor"
            android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvBdPoints"  android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Points" android:textSize="13sp" android:textColor="@color/black"/>
                <TextView android:id="@+id/tvBdSmashes" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Smashes + Aces" android:textSize="13sp" android:textColor="@color/black"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvBdFaults"   android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Faults" android:textSize="13sp" android:textColor="@color/black"/>
                <TextView android:id="@+id/tvBdOutShots" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Out Shots" android:textSize="13sp" android:textColor="@color/black"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>