<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Team Toggle Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#F3F4F6"
            android:padding="4dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvTeam1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TEAM 1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/tab_selected"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvTeam2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TEAM 2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="#FF444444"
                android:textColor="#AAAAAA" />
        </LinearLayout>

        <!-- Filter Header -->
        <LinearLayout
            android:id="@+id/layoutFilterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="#F9FAFB">

            <TextView
                android:id="@+id/btnToggleFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ Show Filters"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:padding="4dp" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvBallCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 of 0 balls"
                android:textSize="12sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/btnClearFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ Clear"
                android:textSize="12sp"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Collapsible Filter Panel -->
        <LinearLayout
            android:id="@+id/layoutFilterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EVENT TYPE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btnFilterAll"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="All" android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#1F2937"
                    android:layout_marginEnd="6dp" />

                <TextView android:id="@+id/btnFilterBoundary"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Boundaries" android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#374151"
                    android:background="#E5E7EB"
                    android:layout_marginEnd="6dp" />

                <TextView android:id="@+id/btnFilterWicket"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Wickets" android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#374151"
                    android:background="#E5E7EB"
                    android:layout_marginEnd="6dp" />

                <TextView android:id="@+id/btnFilterExtra"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Extras" android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#374151"
                    android:background="#E5E7EB"
                    android:layout_marginEnd="6dp" />

                <TextView android:id="@+id/btnFilterDot"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Dots" android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#374151"
                    android:background="#E5E7EB" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Spinner
                    android:id="@+id/spinnerBatsman"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/spinnerBowler"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ✅ Content Area — AB LinearLayout ke ANDAR hai -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBallByBall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:scrollbars="vertical"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/loadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="#E31212" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fetching Timeline..."
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_empty_state" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Innings history will appear here\nonce the match starts."
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEmptyFiltered"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:background="#F9FAFB"
                android:visibility="gone">

                <TextView android:text="🔍"
                    android:textSize="40sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No balls match this filter"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/btnClearFromEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Clear Filters"
                    android:textColor="#E31212"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="8dp"/>
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>  <!-- ✅ Main LinearLayout yahan close -->

</androidx.cardview.widget.CardView>