<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚽ Futsal Stats"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/primaryColor"
            android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvFutsalGoals"   android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Goals" android:textSize="13sp" android:textColor="@color/black" />
                <TextView android:id="@+id/tvFutsalAssists" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Assists" android:textSize="13sp" android:textColor="@color/black"/>
                <TextView android:id="@+id/tvFutsalGplusA"  android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="G+A" android:textSize="13sp" android:textColor="@color/black" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvFutsalFouls"  android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Fouls" android:textSize="13sp" android:textColor="@color/black" />
                <TextView android:id="@+id/tvFutsalYellow" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Yellow Cards" android:textSize="13sp" android:textColor="@color/black"/>
                <TextView android:id="@+id/tvFutsalRed"    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:hint="Red Cards" android:textSize="13sp" android:textColor="@color/black"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>