<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#E31212">

        <!-- Close + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_close_circle"/>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 Whose Home Run?"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

        <!-- Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT TEAM"
            android:textColor="#FFCCCC"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp"/>

        <!-- Team 1 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTeam1"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Team A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#CC0000"
            app:cornerRadius="12dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            android:layout_marginBottom="12dp"/>

        <!-- Team 2 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTeam2"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Team B"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#CC0000"
            app:cornerRadius="12dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            android:layout_marginBottom="24dp"/>

        <!-- Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="CONFIRM HOME RUN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false"
            android:alpha="0.5"
            app:backgroundTint="#10B981"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>