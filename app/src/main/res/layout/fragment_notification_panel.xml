<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_card"
    android:elevation="12dp">

    <!-- ── Header ───────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical">

        <!-- Bell icon + Title -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_event_default"
            android:tint="#E31212"
            android:layout_marginEnd="7dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notifications"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.02"/>

        <!-- Unread badge -->
        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_red_pill"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:visibility="gone"
            android:layout_marginEnd="6dp"
            android:text="0"/>

        <!-- Mark all read button -->
        <ImageView
            android:id="@+id/btnMarkAllRead"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_check_circle"
            android:padding="6dp"
            android:tint="#9CA3AF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mark all as read"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A"/>

    <!-- ── Empty state ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_event_default"
            android:tint="#3A3A3A"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNoNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No notifications yet"
            android:textSize="13sp"
            android:textColor="#6B7280"/>
    </LinearLayout>

    <!-- ── List ───────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:background="#111111"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        android:paddingVertical="4dp"/>

    <!-- ── Footer — "All caught up" ──────────────────────────────── -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You're all caught up ✓"
        android:textSize="11sp"
        android:textColor="#4B5563"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:background="#111111"
        android:visibility="gone"/>

</LinearLayout>