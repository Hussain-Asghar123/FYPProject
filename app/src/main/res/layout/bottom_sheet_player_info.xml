<?xml version="1.0" encoding="utf-8"?>
<!-- bottom_sheet_player_info.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top_sheet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressPlayerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="32dp" />

        <!-- Error -->
        <TextView
            android:id="@+id/tvPlayerInfoError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:visibility="gone"
            android:text="Failed to load info." />

        <!-- Content -->
        <LinearLayout
            android:id="@+id/layoutPlayerInfoContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header: photo + name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <!-- Photo or initial -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivPlayerInfoPhoto"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:civ_border_width="2dp"
                        app:civ_border_color="#DC2626"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPlayerInfoInitial"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#DC2626"
                        android:background="@drawable/circle_red"
                        android:visibility="gone"
                        android:text="" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvPlayerInfoName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:text="Player Name" />

                    <TextView
                        android:id="@+id/tvPlayerInfoJersey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:text="Jersey #N/A" />

                    <TextView
                        android:id="@+id/tvPlayerInfoSports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF"
                        android:layout_marginTop="2dp"
                        android:text="Sports: None" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginBottom="16dp"/>

            <!-- Teams -->
            <TextView
                android:id="@+id/tvTeamsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:text="TEAMS (0)"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlayerInfoTeams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Tournaments -->
            <TextView
                android:id="@+id/tvTournamentsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:text="TOURNAMENTS (0)"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlayerInfoTournaments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Total Matches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_gray_rounded_light"
                android:padding="12dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL MATCHES PLAYED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"/>

                <TextView
                    android:id="@+id/tvPlayerInfoMatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:text="0"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>