<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Unread dot -->
    <View
        android:id="@+id/dotUnread"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:background="@drawable/bg_red_pill"
        android:layout_marginEnd="10dp"
        android:visibility="invisible"/>

    <!-- Icon by type -->
    <TextView
        android:id="@+id/tvNotifType"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:textSize="16sp"
        android:background="@drawable/bg_gray_rounded_light"
        android:layout_marginEnd="10dp"
        android:text="🔔"/>

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvNotifMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"/>

    </LinearLayout>

    <!-- Time -->
    <TextView
        android:id="@+id/tvNotifTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#6B7280"
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        android:gravity="top"/>

</LinearLayout>